# empire-agora — environment
#
# Copy to `.env` ON THE SERVER ONLY. `.env` is gitignored; never commit real values.
# This project's history includes real leaked credentials, and removing a secret from
# HEAD does not remove it from history.

# ---------------------------------------------------------------------------
# Order storage
# ---------------------------------------------------------------------------
# Directory for the SQLite ledger. Must be a MOUNTED VOLUME, or every container
# rebuild silently discards the orders.
DATA_DIR=/data

# ---------------------------------------------------------------------------
# Payment rails
# ---------------------------------------------------------------------------
# These are revealed to a buyer ONLY in the response to creating an order — never in
# page markup. A payment number on a public page is an impersonation vector: someone
# screenshots the page with their own number and collects from your buyers.
#
# Egypt (these also act as the geo gate: both need an Egyptian phone or bank, so the
# EGP tier enforces itself).
RAIL_VODAFONE_CASH=
RAIL_INSTAPAY=

# International.
RAIL_PAYPAL=
RAIL_BANK_TRANSFER=
RAIL_CRYPTO=

# ---------------------------------------------------------------------------
# Owner access
# ---------------------------------------------------------------------------
# Long random string. Guards the order queue. Generate with:
#   openssl rand -hex 32
ADMIN_TOKEN=
